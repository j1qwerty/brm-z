{
  "name": "bmrc-school-management",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "main": "dist-electron/main.cjs",
  "description": "BRM School Management - Indian school management system (Nursery-12), offline-first Firebase app",
  "author": {
    "name": "BRM International Public School",
    "email": "office@bmrcpublicschool.in"
  },
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "electron:build": "node scripts/electron-build.mjs",
    "electron:dev": "node scripts/electron-build.mjs && concurrently -k -n vite,electron -c cyan,magenta \"pnpm dev\" \"electron .\"",
    "electron:start": "pnpm build && pnpm icons && pnpm electron:build && electron . --dist",
    "electron:dist": "pnpm build && pnpm icons && pnpm electron:build && electron-builder --win --publish never",
    "electron:dist:dir": "pnpm build && pnpm icons && pnpm electron:build && electron-builder --win --dir --publish never",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test/run.ts",
    "test:sync": "tsx scripts/test/run.ts --sync",
    "test:live": "tsx scripts/test/live-firestore.ts",
    "test:portal": "tsx scripts/test/portal-rules.ts",
    "test-reset": "tsx scripts/test/reset-firestore-tests.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "users:create": "tsx scripts/create-user.ts",
    "users:promote": "tsx scripts/promote.ts",
    "emulators": "firebase emulators:start --import=./firebase-data --export-on-exit",
    "rules:deploy": "firebase deploy --only firestore:rules,firestore:indexes",
    "rules:test": "tsx scripts/rules-smoke.ts",
    "fb:login": "firebase login",
    "netlify:login": "netlify login",
    "netlify:init": "netlify init",
    "netlify:env": "netlify env:set",
    "deploy:preview": "netlify deploy --build",
    "deploy": "pnpm build && netlify deploy --prod"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.5",
    "@hookform/resolvers": "^5.1.1",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "driver.js": "^1.3.6",
    "firebase": "^12.1.0",
    "html2canvas-pro": "^1.5.8",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.525.0",
    "motion": "^12.23.0",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.60.0",
    "react-moveable": "^0.56.0",
    "react-router": "^7.6.3",
    "recharts": "^3.1.0",
    "sonner": "^2.0.6",
    "sql.js": "^1.14.2",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.5",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.15.0",
    "@types/papaparse": "^5.3.16",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^10.0.5",
    "dotenv": "^17.0.0",
    "electron": "^44",
    "electron-builder": "^26",
    "esbuild": "^0.28.2",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "firebase-admin": "^13.4.0",
    "firebase-tools": "^14.0.1",
    "globals": "^16.3.0",
    "netlify-cli": "^23.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0"
  }
}
