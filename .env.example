# Firebase (Project settings > General > Your apps > Web app config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App environment: development (default) or production.
# production enforces strict invariants (exactly one active session);
# development relaxes them for testing (multiple sessions may be active).
VITE_APP_ENV=development

# Local admin scripts (scripts/ folder, firebase-admin). NOT exposed to the app.
# Path to the service account private key JSON (never commit this file).
SERVICE_ACCOUNT_PATH=./scripts/service-account.json
FIREBASE_PROJECT_ID=
